{
  "name": "@rialink/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Rialink — decentralized identity on Rialo",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rialink",
    "rialo",
    "identity",
    "decentralized",
    "web3",
    "wallet"
  ],
  "author": "Abdulmalik Abdulrashid <abdulmalikabdulrashid1@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
